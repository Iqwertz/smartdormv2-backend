export PRODUCTION=False # Only set this to False in production environments
export DEVELOPER_EMAIL=your_email@example.com # Emails sent during development will all go to this address, in production this is ignored
export DB_HOST=db-test-smartdorm-V2.schollheim.net
export DB_PORT=5432
export POSTGRES_USER=pg
export POSTGRES_DB=testing
export DB_PASSWORD=...
export SECRET_KEY=...
export LDAP_URI=ldap://ldap-test.schollheim.net:389
export LDAP_ADMIN_PASSWORD=...
export REDIS_URL=redis://localhost:6379/1
export EMAIL_HOST_PASSWORD=...
export LOCAL_ENV=True # Set to True if you use a localhost environment.

# Pi Scan Service Configuration
export PI_SCAN_SERVICE_URL=http://192.168.0.124:8000
export PI_SCAN_SERVICE_TIMEOUT=300
# Fernet keys for encrypted database fields (currently: HSV membership IBANs).
# Comma-separated; the first key encrypts, every key can decrypt (that is how rotation works).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
export FIELD_ENCRYPTION_KEYS=
